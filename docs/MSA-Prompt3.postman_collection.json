    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200]);",
              "});",
              "if ([200].includes(pm.response.code)) {",
              "  pm.test(\"System UP\", () => {",
              "    pm.expect(pm.response.json().status).to.eql(\"UP\");",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
